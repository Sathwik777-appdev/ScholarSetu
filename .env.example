# ScholarSetu environment template. `python3 scripts/make_env.py` copies this to .env and fills every
# secret with a fresh random value (add --demo for a local demo). Never commit .env.

# --- Core ---------------------------------------------------------------------------
# Host ports published by infra/docker-compose.yml (the containers use their own internal URLs).
DATABASE_URL=postgresql+asyncpg://scholarsetu:scholarsetu_dev@localhost:5434/scholarsetu
REDIS_URL=redis://localhost:6380
NATS_URL=nats://localhost:4223
MOCK_SERVICE_URL=http://localhost:8100

# At least 32 characters (openssl rand -hex 32). The API refuses to start without it.
JWT_SECRET=
JWT_EXPIRE_MINUTES=15

# Ed25519 key that signs attestations. Create it with `make keys`. The API refuses to start without it.
ATTESTATION_PRIVATE_KEY_PATH=secrets/attestation_ed25519.pem

# Browser origins allowed to call the API (comma-separated). "*" is rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Demo mode: seeded demo users (scripts/seed_demo.py) may log in with DEMO_OTP, SLA timers shrink to
# SLA_DEMO_SECONDS, and /v1/dev/sms-outbox shows the simulated SMS. Keep false outside a local demo.
DEMO_MODE=false
DEMO_OTP=123456
SLA_DEMO_SECONDS=120

# Shared secret JAGO sends as X-Service-Token on /v1/skill/tools/* (>= 32 chars). Empty = disabled.
SKILL_SERVICE_TOKEN=

# The human helpline JAGO offers when it cannot answer. Empty = the institute's scholarship nodal officer.
JAGO_HELPLINE=

# Object storage for wallet documents (SeaweedFS S3 gateway in compose). Password: at least 8 characters.
MINIO_ROOT_USER=scholarsetu
MINIO_ROOT_PASSWORD=

# Shared key for privacy-preserving record linkage (Reach Radar), >= 32 characters. The same value
# must be configured at every data holder (the UDISE+ mock reads it too). Empty = Reach Radar off.
PPRL_HMAC_KEY=

# Shared secret the SMS gateway sends as X-SMS-Gateway-Token on inbound webhooks. Empty = inbound SMS off.
SMS_GATEWAY_TOKEN=

# --- Console (apps/console) ----------------------------------------------------------
VITE_API_URL=http://localhost:8000
