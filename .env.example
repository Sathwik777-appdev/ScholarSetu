# ScholarSetu environment template. Copy to .env and fill in values.
# Never commit .env: it is git-ignored and docker-ignored.

# --- Core (required) -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://scholarsetu:scholarsetu_dev@localhost:5434/scholarsetu
REDIS_URL=redis://localhost:6380
NATS_URL=nats://localhost:4223
MOCK_SERVICE_URL=http://localhost:8100

# At least 32 characters. Generate one with: openssl rand -hex 32
# The API refuses to start if this is missing or too short.
JWT_SECRET=
JWT_EXPIRE_MINUTES=15

# Ed25519 key used to sign attestations. Create it with `make keys`.
# If missing, the API refuses to start (unless DEMO_MODE=true, which generates a demo key).
ATTESTATION_PRIVATE_KEY_PATH=secrets/attestation_ed25519.pem

# Browser origins allowed to call the API (comma-separated). "*" is rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Demo mode: seeded demo users (scripts/seed_demo.py) may log in with DEMO_OTP.
# Leave false everywhere except a local demo.
DEMO_MODE=false
DEMO_OTP=123456

# Shared secret JAGO sends as X-Service-Token on /v1/skill/tools/* (>= 32 chars).
# Leave empty to keep the skill endpoints disabled.
SKILL_SERVICE_TOKEN=

# JAGO: the human helpline offered when JAGO cannot answer. Leave empty to point students to
# their institute's scholarship nodal officer (no number is invented).
JAGO_HELPLINE=

# Object storage for wallet documents (MinIO). Used by the minio container and by the API.
MINIO_ROOT_USER=scholarsetu
# At least 8 characters. Generate: openssl rand -hex 16
MINIO_ROOT_PASSWORD=

# Shared key for privacy-preserving record linkage (Reach Radar). >= 32 characters; the same value
# must be configured at every data holder. Generate: openssl rand -hex 32
PPRL_HMAC_KEY=

# Shared secret the SMS gateway sends as X-SMS-Gateway-Token on inbound webhooks (STATUS command).
# Leave empty to disable inbound SMS. Generate: openssl rand -hex 24
SMS_GATEWAY_TOKEN=

# DEMO_MODE only: SLA deadlines and escalations shrink to this many seconds so breaches show live.
SLA_DEMO_SECONDS=120

# --- Optional AI / language services ----------------------------------------------
GEMINI_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
OPENAI_API_KEY=

# --- Government sandbox credentials (unused until real integrations exist) ----------
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
UIDAI_SUB_AUA_CODE=
UIDAI_LICENSE_KEY=
NPCI_API_KEY=
PFMS_CLIENT_ID=
PFMS_CLIENT_SECRET=
UDISE_API_KEY=

# --- SMS (unused: the prototype stores outbound SMS in the database) ----------------
NIC_SMS_API_KEY=

# --- Console ------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
