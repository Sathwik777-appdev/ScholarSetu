FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# Install PostgreSQL 16 and pgvector
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gnupg ca-certificates lsb-release \
    && curl -sS https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/trusted.gpg.d/pgdg.gpg \
    && echo "deb http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    postgresql-16 postgresql-16-pgvector \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY services/core/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Bake embedding model into image
ENV EMBEDDING_CACHE_DIR=/opt/models
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2', cache_dir='/opt/models')" \
    && chmod -R a+rX /opt/models

COPY services/core/ /app/
COPY rules/ /rules/
COPY adapters/ /adapters/
COPY scripts/seed_demo.py /scripts/seed_demo.py

# Initialize database, run migrations, and seed demo dataset at build time
ENV DATABASE_URL=postgresql+asyncpg://scholarsetu:scholarsetu_dev@localhost:5432/scholarsetu \
    DEMO_MODE=true \
    DEMO_OTP=123456 \
    JWT_SECRET=supersecret-scholarsetu-jwt-demo-key-32chars-minimum \
    OUTBOX_PUBLISHER_ENABLED=false \
    ADAPTER_SYNC_INTERVAL_SECONDS=0 \
    ATTESTATION_PRIVATE_KEY_PATH=/app/secrets/attestation_ed25519.pem

RUN mkdir -p /var/lib/postgresql/data /var/run/postgresql /app/secrets \
    && chown -R postgres:postgres /var/lib/postgresql /var/run/postgresql \
    && su - postgres -c "/usr/lib/postgresql/16/bin/initdb -D /var/lib/postgresql/data" \
    && su - postgres -c "/usr/lib/postgresql/16/bin/pg_ctl -D /var/lib/postgresql/data -l /var/lib/postgresql/data/logfile start -w" \
    && su - postgres -c "psql -c 'CREATE DATABASE scholarsetu;'" \
    && su - postgres -c "psql -d scholarsetu -c 'CREATE EXTENSION IF NOT EXISTS vector;'" \
    && su - postgres -c "psql -c \"CREATE USER scholarsetu WITH PASSWORD 'scholarsetu_dev';\"" \
    && su - postgres -c "psql -c 'GRANT ALL PRIVILEGES ON DATABASE scholarsetu TO scholarsetu;'" \
    && su - postgres -c "psql -d scholarsetu -c 'GRANT ALL ON SCHEMA public TO scholarsetu;'" \
    && alembic upgrade head \
    && python /scripts/seed_demo.py \
    && su - postgres -c "/usr/lib/postgresql/16/bin/pg_ctl -D /var/lib/postgresql/data stop -w"

COPY services/core/entrypoint-cloudrun.sh /app/entrypoint-cloudrun.sh
RUN chmod +x /app/entrypoint-cloudrun.sh

EXPOSE 8080
ENTRYPOINT ["/app/entrypoint-cloudrun.sh"]
